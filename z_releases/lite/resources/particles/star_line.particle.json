{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "elspirit:star_line",
			"basic_render_parameters": {
				"material": "particles_blend",
				"texture": "textures/particles/fantasy_line"
			}
		},
		"components": {
			"minecraft:emitter_rate_instant": {
