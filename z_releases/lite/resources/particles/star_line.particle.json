			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.emitter_age / 7",
					"gradient": {
						"0.0": "#2BE4F4FF",
						"0.03": "#66DBF0FF",
						"0.82": "#FFABCAFF",
						"1.0": "#0AF3F9FF"
